      ],
      "ticks": [
        {
          "id": "wrong_sample",
          "observations": [
            {"id": "calibration_pass1", "source": "calibration_status", "text": "Calibration has passed."},
            {"id": "sample_wrong", "source": "sample_tray", "text": "Sample S3 is loaded. Sample S8 is not loaded."}
          ],
          "expected_records": [{"origin_id": "spectrum_scan", "unchanged_from_initial": true}],
          "expected_rounds": [[{"origin_id": "spectrum_scan", "kind": "WAIT"}]]
        },
        {
          "id": "correct_sample_and_calibration",
          "observations": [
            {"id": "calibration_pass2", "source": "calibration_status", "text": "Calibration has passed."},
            {"id": "sample_correct", "source": "sample_tray", "text": "Sample S8 is now loaded."}
          ],
          "expected_records": [{"origin_id": "spectrum_scan", "unchanged_from_initial": true}],
          "expected_rounds": [[{"origin_id": "spectrum_scan", "kind": "ACT"}]]
        }
      ]
    },
    {
      "id": "relative_elapsed_time_no_invented_clock",
