        {
          "id": "twenty_minutes",
          "observations": [{"id": "elapsed_20", "source": "elapsed_timer", "text": "Time elapsed since the glaze application started: 20 minutes."}],
          "expected_records": [{"origin_id": "masking_tape", "clock_op": "none", "clock_time": "", "unchanged_from_initial": true}],
