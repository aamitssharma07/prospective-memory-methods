    {
      "id": "three_unrelated_obligations_preserve_identity",
      "sources": ["events", "barcode_reader"],
      "queryable_sources": [],
      "instructions": [
        {"id": "camera_lens", "text": "Mount the camera lens when the tripod is locked securely."}
      ],
      "expected_initial_records": [
        {"origin_id": "camera_lens", "required_sources": ["events"], "clock_op": "none", "action_contains_any": ["lens"]}
      ],
      "ticks": [
        {
          "id": "add_two_independent_requests",
          "instructions": [
            {"id": "specimen_log", "text": "Also, copy the specimen identifier into the lab notebook when barcode_reader reports a successful specimen scan."},
            {"id": "crate_label", "text": "Also, attach the destination label when the transport crate's latch clicks shut."}
          ],
          "observations": [
            {"id": "tripod_locked", "text": "The tripod is locked securely. The transport crate's latch is still open."},
            {"id": "barcode_no_scan", "source": "barcode_reader", "text": "No successful specimen scan has occurred."}
          ],
          "expected_records": [
            {"origin_id": "camera_lens", "unchanged_from_initial": true},
            {"origin_id": "specimen_log", "instruction_ids": ["specimen_log"], "required_sources": ["barcode_reader"], "action_contains_any": ["identifier", "notebook"]},
            {"origin_id": "crate_label", "instruction_ids": ["crate_label"], "required_sources": ["events"], "action_contains_any": ["label"]}
          ],
          "expected_rounds": [[
            {"origin_id": "camera_lens", "kind": "ACT"},
            {"origin_id": "specimen_log", "kind": "WAIT"},
            {"origin_id": "crate_label", "kind": "WAIT"}
          ]]
        },
        {
          "id": "other_two_conditions_occur",
          "observations": [
            {"id": "crate_shut", "text": "The tripod has been unlocked. The transport crate's latch clicks shut."},
            {"id": "barcode_success", "source": "barcode_reader", "text": "Successful specimen scan. Specimen identifier: ZX-47."}
          ],
          "expected_records": [
            {"origin_id": "camera_lens", "unchanged_from_initial": true},
            {"origin_id": "specimen_log", "instruction_ids": ["specimen_log"], "required_sources": ["barcode_reader"]},
            {"origin_id": "crate_label", "instruction_ids": ["crate_label"], "required_sources": ["events"]}
          ],
          "expected_rounds": [[
            {"origin_id": "camera_lens", "kind": "WAIT"},
            {"origin_id": "specimen_log", "kind": "ACT"},
            {"origin_id": "crate_label", "kind": "ACT"}
          ]]
        }
      ]
    },
