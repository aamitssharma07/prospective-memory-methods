      "expected_initial_records": [
        {"origin_id": "archive_build_logs", "required_sources": ["storage_monitor", "backup_status"], "clock_op": "none", "action_contains_any": ["logs"]}
      ],
      "ticks": [
        {
          "id": "backup_done_but_usage_low",
          "observations": [
            {"id": "storage_79", "source": "storage_monitor", "text": "Current storage usage: 79 percent."},
            {"id": "backup_done_early", "source": "backup_status", "text": "The current build's backup has completed."}
          ],
          "expected_records": [{"origin_id": "archive_build_logs", "unchanged_from_initial": true}],
          "expected_rounds": [[{"origin_id": "archive_build_logs", "kind": "WAIT"}]]
        },
        {
          "id": "threshold_met_check_backup",
          "observations": [{"id": "storage_80", "source": "storage_monitor", "text": "Current storage usage: 80 percent."}],
          "pull_responses": {"backup_status": [{"id": "backup_done_now", "source": "backup_status", "text": "The current build's backup has completed."}]},
          "expected_records": [{"origin_id": "archive_build_logs", "unchanged_from_initial": true}],
          "expected_rounds": [
            [{"origin_id": "archive_build_logs", "kind": "CHECK", "source": "backup_status"}],
            [{"origin_id": "archive_build_logs", "kind": "ACT"}]
          ]
        }
      ]
    }
  ]
