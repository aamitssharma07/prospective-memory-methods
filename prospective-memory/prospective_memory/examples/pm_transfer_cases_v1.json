{
  "version": 1,
  "name": "Independent authored prospective-memory transfer diagnostic v1",
  "protocol": "Authored and frozen before any live run of these cases. Public inputs and tool replies are separate from scorer-only expected records and decisions. This is an independent authored development transfer diagnostic, not an external held-out benchmark. A deterministic host follows supported CHECK proposals; ACT is never executed or acknowledged. Expected record text fragments are limited lexical diagnostics, not complete semantic validation.",
  "cases": [
    {
      "id": "greenhouse_strict_numeric_threshold",
      "sources": ["events", "greenhouse_sensor"],
      "queryable_sources": [],
      "instructions": [
        {"id": "greenhouse_cover", "text": "Remind me to cover the seedlings when the greenhouse sensor reports a temperature below 12 degrees Celsius."}
      ],
      "expected_initial_records": [
        {"origin_id": "greenhouse_cover", "required_sources": ["greenhouse_sensor"], "clock_op": "none", "action_contains_any": ["seedling"]}
      ],
      "ticks": [
        {
          "id": "exact_boundary_is_not_below",
          "observations": [{"id": "temperature_12", "source": "greenhouse_sensor", "text": "Current greenhouse temperature: 12 degrees Celsius."}],
          "expected_records": [{"origin_id": "greenhouse_cover", "unchanged_from_initial": true}],
          "expected_rounds": [[{"origin_id": "greenhouse_cover", "kind": "WAIT"}]]
        },
        {
          "id": "below_boundary",
          "observations": [{"id": "temperature_11", "source": "greenhouse_sensor", "text": "Current greenhouse temperature: 11 degrees Celsius."}],
          "expected_records": [{"origin_id": "greenhouse_cover", "unchanged_from_initial": true}],
          "expected_rounds": [[{"origin_id": "greenhouse_cover", "kind": "ACT"}]]
        }
      ]
    },
    {
      "id": "render_job_hidden_status_roundtrips",
      "sources": ["events", "render_queue"],
      "queryable_sources": ["render_queue"],
      "instructions": [
        {"id": "render_preview", "text": "Send the animation preview to the team when render_queue reports that job R42 has completed successfully."}
      ],
      "expected_initial_records": [
        {"origin_id": "render_preview", "required_sources": ["render_queue"], "clock_op": "none", "action_contains_any": ["preview"]}
      ],
      "ticks": [
        {
          "id": "first_query_still_rendering",
          "observations": [{"id": "editing_scene", "text": "You are editing a scene. No render-job status is visible."}],
          "pull_responses": {"render_queue": [{"id": "render_running", "source": "render_queue", "text": "Job R42 is still rendering and has not completed."}]},
          "expected_records": [{"origin_id": "render_preview", "unchanged_from_initial": true}],
          "expected_rounds": [
            [{"origin_id": "render_preview", "kind": "CHECK", "source": "render_queue"}],
            [{"origin_id": "render_preview", "kind": "WAIT"}]
          ]
        },
        {
          "id": "later_query_finished",
          "observations": [{"id": "layout_scene", "text": "You are adjusting the layout. No current render-job status is visible."}],
          "pull_responses": {"render_queue": [{"id": "render_finished", "source": "render_queue", "text": "Job R42 has completed successfully. Its animation preview is ready."}]},
          "expected_records": [{"origin_id": "render_preview", "unchanged_from_initial": true}],
          "expected_rounds": [
            [{"origin_id": "render_preview", "kind": "CHECK", "source": "render_queue"}],
            [{"origin_id": "render_preview", "kind": "ACT"}]
          ]
        }
      ]
    },
    {
      "id": "instrument_two_observable_conditions",
      "sources": ["events", "calibration_status", "sample_tray"],
      "queryable_sources": [],
