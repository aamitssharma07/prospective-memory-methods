    {
      "id": "simulation_revision_retains_validation",
      "sources": ["events", "clock", "quality_panel"],
      "queryable_sources": ["clock", "quality_panel"],
      "instructions": [
        {"id": "simulation_publish", "text": "Publish the simulation output no earlier than 14:20, and only if quality_panel reports that validation has passed."}
      ],
      "expected_initial_records": [
        {"origin_id": "simulation_publish", "required_sources": ["clock", "quality_panel"], "clock_op": "not_before", "clock_time": "14:20", "action_contains_any": ["simulation"], "condition_contains_any": ["validation"]}
      ],
      "ticks": [
        {
          "id": "revised_time_not_reached",
          "instructions": [{"id": "simulation_later", "text": "Change the earliest publishing time for the simulation output to 15:10 instead; keep its validation requirement."}],
          "observations": [
            {"id": "release_clock_1450", "source": "clock", "text": "Current time: 14:50."},
            {"id": "release_valid_early", "source": "quality_panel", "text": "Validation has passed for the simulation output."}
          ],
          "expected_records": [{"origin_id": "simulation_publish", "instruction_ids": ["simulation_publish", "simulation_later"], "preserve_identity": true, "required_sources": ["clock", "quality_panel"], "clock_op": "not_before", "clock_time": "15:10", "condition_contains_any": ["validation"]}],
          "expected_rounds": [[{"origin_id": "simulation_publish", "kind": "WAIT"}]]
        },
        {
          "id": "revised_time_but_validation_failed",
          "observations": [
            {"id": "release_clock_1510a", "source": "clock", "text": "Current time: 15:10."},
            {"id": "release_invalid", "source": "quality_panel", "text": "Validation has failed for the simulation output. It has not passed."}
          ],
          "expected_records": [{"origin_id": "simulation_publish", "instruction_ids": ["simulation_publish", "simulation_later"], "preserve_identity": true, "required_sources": ["clock", "quality_panel"], "clock_op": "not_before", "clock_time": "15:10", "condition_contains_any": ["validation"]}],
          "expected_rounds": [[{"origin_id": "simulation_publish", "kind": "WAIT"}]]
        },
        {
          "id": "revised_all_conditions_hold",
          "observations": [
            {"id": "release_clock_1510b", "source": "clock", "text": "Current time: 15:10."},
            {"id": "release_valid_now", "source": "quality_panel", "text": "Validation has passed for the simulation output."}
          ],
          "expected_records": [{"origin_id": "simulation_publish", "instruction_ids": ["simulation_publish", "simulation_later"], "preserve_identity": true, "required_sources": ["clock", "quality_panel"], "clock_op": "not_before", "clock_time": "15:10"}],
          "expected_rounds": [[{"origin_id": "simulation_publish", "kind": "ACT"}]]
        }
      ]
    },
