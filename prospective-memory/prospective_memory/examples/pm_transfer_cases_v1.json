    {
      "id": "storage_threshold_and_backup_confirmation",
      "sources": ["events", "storage_monitor", "backup_status"],
      "queryable_sources": ["storage_monitor", "backup_status"],
      "instructions": [
        {"id": "archive_build_logs", "text": "Archive the build logs when storage_monitor reports usage of at least 80 percent, but only if backup_status confirms that the current build's backup has completed."}
